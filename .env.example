# Variables d'environnement du service Auth (modèle). Le service lit UNIQUEMENT l'environnement :
# en local avec tout le projet, elles sont fournies par le dépôt infra-compose ; en déploiement, par la
# plateforme (variables + secrets). Ce fichier sert de référence, ou à lancer le conteneur seul :
#     docker run --env-file .env -p 8001:8000 bodyvision/auth:dev
# `.env` est ignoré par Git. Ne commitez jamais de secret.

# ---- Base de données : le rôle SQL PROPRE au service (accès limité au schéma « utilisateurs ») ---
# accepte aussi un chemin de socket Unix (/chemin/vers/dossier)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bodyvision
DB_USER=bv_utilisateurs
# OBLIGATOIRE : le service refuse de démarrer sans
DB_PASSWORD=
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# ---- Appels service-à-service (ex. Analytique -> /v1/internal/users/{id}/morphology) ------------
# OBLIGATOIRE, 16 caractères minimum. Même valeur chez les services qui appellent Auth.
INTERNAL_SERVICE_TOKEN=

# ---- Jetons -------------------------------------------------------------------------------------
JWT_ISSUER=bodyvision-auth
JWT_AUDIENCE=bodyvision
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Clé privée RSA de signature : un fichier PEM (défaut) ou le PEM en variable (\n littéraux acceptés).
JWT_PRIVATE_KEY_FILE=/run/keys/jwt_private.pem
# JWT_PRIVATE_KEY=
# true = crée la clé au 1er démarrage si le fichier est absent. DÉVELOPPEMENT UNIQUEMENT :
# avec plusieurs instances, chacune génèrerait une clé différente. En production : false + clé fournie.
JWT_AUTOGENERATE_KEYS=false

# ---- Divers -------------------------------------------------------------------------------------
LOG_LEVEL=INFO
# Swagger UI (/docs), ReDoc (/redoc), /openapi.json. false en production.
ENABLE_DOCS=true
# Joue `alembic upgrade head` au démarrage du conteneur. Avec plusieurs réplicas : false + un Job
# de migration (`alembic upgrade head`) ; un verrou PostgreSQL évite déjà que deux instances migrent ensemble.
RUN_MIGRATIONS=true
